	section
		+rd-parallax({
			"src": "images/parallax-05.jpg"
		})
			.container.section-75.section-md-90.text-md-start
				.row.justify-content-sm-center.justify-content-xl-between.align-items-md-center
					.col-md-6.col-xl-5
						img.img-responsive(src='images/home-07-466x459.png' width=466 height=459 alt='')
