section.text-center.section-65.section-sm-bottom-85
  .container
    h3.text-center Progress Bars
    hr.divider
    .progress-container.row.offset-top-40
      // Progress Bar
      .col-sm-6.col-md-6.col-lg-3
          .progress-bar-wrapper
            .progress-bar-js.progress-bar-radial.progress-bar-primary(data-value='50', data-stroke='8', data-trail="8", data-easing='linear', data-duration='1000', data-counter="true")
          p.h5.offset-top-15 CLIENTS
      .col-sm-6.col-md-6.col-lg-3.offset-top-40.offset-xs-top-0
          .progress-bar-wrapper
            .progress-bar-js.progress-bar-radial.progress-bar-primary(data-value='75', data-stroke='8',data-trail="8", data-easing='linear', data-duration='1000', data-counter="true")
          p.h5.offset-top-15 PANELS SOLD
      .col-sm-6.col-md-6.col-lg-3.offset-top-40.offset-md-top-0
          .progress-bar-wrapper
            .progress-bar-js.progress-bar-radial.progress-bar-primary(data-value='25', data-stroke='8',data-trail="8", data-easing='linear', data-duration='1000', data-counter="true")
          p.h5.offset-top-15 PARTNERS
      .col-sm-6.col-md-6.col-lg-3.offset-top-40.offset-md-top-0
          .progress-bar-wrapper
            .progress-bar-js.progress-bar-radial.progress-bar-primary(data-value='100', data-stroke='8',data-trail="8", data-easing='linear', data-duration='1000', data-counter="true")
          p.h5.offset-top-15 REVIEWS